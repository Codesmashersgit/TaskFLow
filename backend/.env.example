# TaskFlow API Configuration
# NOTE: All variables below have built-in safe defaults.
# The application starts and runs 100% out of the box without any .env file!

PORT=5001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional: PostgreSQL Database (Mock REST mode is used automatically if not connected)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/taskflow
